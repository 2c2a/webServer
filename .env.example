# 2c2a 环境变量配置

# ========== 核心 ==========
DEBUG=true
SECRET_KEY=change-me-in-production-32-chars-min!!
DEMO_MODE=false

# ========== 数据库 (PostgreSQL) ==========
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=2c2a
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ========== Redis ==========
REDIS_URL=redis://localhost:6379/0

# ========== Huey ==========
HUEY_REDIS_DB=1
HUEY_IMMEDIATE=false

# ========== JWT ==========
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 会话 ==========
SESSION_EXPIRE_SECONDS=3600
SESSION_COOKIE_SECURE=false

# ========== CORS ==========
CORS_ALLOWED_ORIGINS=http://localhost:8000,https://localhost

# ========== 安全 ==========
ALLOWED_HOSTS=localhost,127.0.0.1

# ========== WinRM ==========
WINRM_TIMEOUT=30
WINRM_MAX_RETRIES=3

# ========== Gateway ==========
GATEWAY_ENABLED=false
GATEWAY_PAA_TOKEN_SIGNING_KEY=change-me-32-chars-minimum!!
GATEWAY_ADDRESS=rdp.2c2a.com
GATEWAY_PORT=443

# ========== RDP ==========
RDP_DOMAIN=2c2a.com

# ========== 限流 ==========
LOGIN_RATE_LIMIT=5
API_RATE_LIMIT=100

# ========== 日志 ==========
LOG_LEVEL=INFO
LOG_FILE=

# ========== SMTP ==========
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ========== Bootstrap ==========
BOOTSTRAP_SHARED_SALT=

# ========== 加密 ==========
ENCRYPTION_KEY=

# ========== 隧道 ==========
TUNNEL_RELEASES_URL=https://api.github.com/repos/2c2a/tunnel/releases/latest
TUNNEL_GATEWAY_URL=wss://gateway.2c2a.com:9000
